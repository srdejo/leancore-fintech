# Copia este archivo a .env para cambiar credenciales o puertos.
POSTGRES_USER=ledger
POSTGRES_PASSWORD=ledger
POSTGRES_DB=ledger
# Puerto del host para conectarse a Postgres (DataGrip, psql). Solo escucha en localhost.
DB_PORT=5432
# Puerto del host donde se publica la aplicación (frontend + /api).
APP_PORT=8080
# Zona horaria para "hoy" (proyección de interés devengado).
APP_TIMEZONE=America/Bogota
